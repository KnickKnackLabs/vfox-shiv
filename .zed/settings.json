{
    "format_on_save": "on",
    "use_on_type_format": false,

    "languages": {
        "Shell Script": {
            "tab_size": 4,
            "hard_tabs": false,
        },

        "Lua": {
            "tab_size": 2,
            "hard_tabs": false,

            "formatter": {
                "external": {
                    "command": "stylua",
                    "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
                },
            },
        },
    },

    "file_types": {
        "Shell Script": ["*.bats"],
    },
}
